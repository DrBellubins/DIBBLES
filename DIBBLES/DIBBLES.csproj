<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <OptimizationPreference>Speed</OptimizationPreference>
        <InvariantGlobalization>true</InvariantGlobalization>
        <LangVersion>default</LangVersion>
        
        <!-- Directs MonoGame.Content.Builder.Task to build assets for Vulkan -->
        <MonoGamePlatform>DesktopVK</MonoGamePlatform>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
      <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5.1" />
      
      <!-- Native Core + Desktop VK Runtimes -->
      <PackageReference Include="MonoGame.Framework.Native" Version="3.8.5.1" />
      <PackageReference Include="MonoGame.Runtime.Windows.Vulkan" Version="3.8.5.1" />
      <PackageReference Include="MonoGame.Runtime.Linux.Vulkan" Version="3.8.5.1" />
      <PackageReference Include="MonoGame.Runtime.Mac.Vulkan" Version="3.8.5.1" />
      <PackageReference Include="NVorbis" Version="0.10.5" />
    </ItemGroup>

    <ItemGroup>
      <RdXmlFile Include="rd.xml" />
    </ItemGroup>

    <ItemGroup>
      <MonoGameContentReference Include="Assets/MG/MG.mgcb">
        <ContentFolder>Assets/MG</ContentFolder>
      </MonoGameContentReference>
    </ItemGroup>

    <ItemGroup>
      <Content Include="Assets/Sounds/**">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>

      <Content Include="Assets/Textures/**">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Assets/Blocks.toml">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Artwork\**" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="Artwork\**" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Artwork\**" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\deps\MonoGame.ImGuiNet-main\MonoGame.ImGuiNet\Monogame.ImGuiNet.csproj" />
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
      <Exec Command="find . \&#xA;  \( -type d \( -name bin -o -name obj -o -name .git -o -name .vs \) -prune \) \&#xA;  -o -type f -print &gt; file_list.txt" />
    </Target>

</Project>
