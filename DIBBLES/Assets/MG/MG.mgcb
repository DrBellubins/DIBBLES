#----------------------------- Global Properties ----------------------------#
/outputDir:bin
/intermediateDir:obj
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#----------------------------- Content ----------------------------#

# Build the MainFont.spritefont as a SpriteFont
/build:Fonts/MainFont.spritefont

# Build the terrain shader
/build:Shaders/Terrain.fx

# Build the UI blur shader
/build:Shaders/UIBlur.fx

# Build the depth prepass shader
/build:Shaders/DepthPrepass.fx

# Build the ssao processing shader
/build:Shaders/SSAOPostProcess.fx
