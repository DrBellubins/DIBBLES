#----------------------------- Global Properties ----------------------------#
/outputDir:bin
/intermediateDir:obj
/platform:DesktopGL
/config:
/profile:HiDef
/compress:False

#----------------------------- Content ----------------------------#

# Build the MainFont.spritefont as a SpriteFont
/build:Fonts/MainFont.spritefont

# Build the blue noise texture for SSAO
/build:Textures/BlueNoise.png

# Build the blit shader
/build:Shaders/Blit.fx

# Build the terrain shader
/build:Shaders/Terrain.fx

# Build the UI blur shader
/build:Shaders/UIBlur.fx

# Build the depth prepass shader
/build:Shaders/DepthPrepass.fx

# Build the ssao processing shader
/build:Shaders/SSAOPostProcess.fx

# Build the billboard instance shader
/build:Shaders/BillboardInstanced.fx

# Build the main surface shader
/build:Shaders/MainSurfaceEffect.fx

# Build the bloom shader
/build:Shaders/Bloom.fx

# Build the tonemap shader
/build:Shaders/Tonemap.fx

# Build the skybox shader
/build:Shaders/Skybox.fx

#----------------------------- Includes/ACES.hlsl ----------------------------#
/copy:Shaders/Includes/ACES.hlsl

#----------------------------- Includes/AgX.hlsl -----------------------------#
/copy:Shaders/Includes/AgX.hlsl
